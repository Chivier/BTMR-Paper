# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Configuration
OPENAI_API_BASE=https://api.openai.com/v1

# Model Configuration
MODEL_NAME=gpt-4.1
TRANSLATE_MODEL=gpt-4.1

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Log Level
LOG_LEVEL='DEBUG'

# VITE URL
# If you didn't put the website on your localhost, change it to your backend address(including port).
# VITE_API_BASE_URL='YOUR_BACKEND_ADDRESS' # e.g. http://192.168.1.123:8000
